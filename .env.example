# ロリポップ接続情報（.env にコピーして記入。.env は Git に入りません）
# ロリポップ ユーザー専用ページ →「サーバーの管理・設定」→「アカウント情報」で確認できます

# ftps（全プランで利用可） または sftp（SSH対応プランのみ）
DEPLOY_PROTOCOL=ftps

# FTPSサーバー（例: ftp.lolipop.jp） / SFTPなら SSHサーバー（例: ssh.lolipop.jp）
DEPLOY_HOST=ftp.lolipop.jp

# FTPS=21 / SFTP=2222（ロリポップのSSHポート）
DEPLOY_PORT=21

# FTPアカウント（SFTPならSSHアカウント）
DEPLOY_USER=

# FTPパスワード（SFTPならSSHパスワード）
DEPLOY_PASS=

# アップロード先フォルダ（ログイン直後の場所からのパス。末尾スラッシュなし）
# 例: jecsa.schoolbus.jp の公開フォルダが「jecsa」なら → jecsa/cheer-you-up
DEPLOY_REMOTE_DIR=
